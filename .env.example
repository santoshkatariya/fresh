# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# META WHATSAPP CLOUD API CONFIGURATION
# Required for the WhatsApp AI farmer assistant webhook and message dispatch
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# SUPABASE CONFIGURATION (Optional Cloud DB persistence)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# GOOGLE MAPS API KEY (Optional for interactive maps)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# MYSQL DATABASE CONFIGURATION
# Connect to your MySQL 8.x database (AWS RDS, Google Cloud SQL, PlanetScale, Aiven, or Local Docker)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=freshroute_db
MYSQL_SSL=false
# Alternatively, provide a full connection string:
# MYSQL_URL=mysql://user:password@host:3306/freshroute_db

